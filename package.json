{
  "name": "meetpoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname ::",
    "build": "prisma generate && node scripts/prisma-migrate-deploy.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/prisma-migrate-deploy.mjs",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "test": "tsx --test lib/*.test.ts",
    "apple:secret": "node scripts/apple-client-secret.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
