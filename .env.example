# App URL (OAuth redirects + absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite for old local-only (do not use on Vercel)
# DATABASE_URL="file:./dev.db"

# Free Postgres for launch (Neon or Supabase) — use this for local + Vercel
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signed session cookies (use a long random string in production)
AUTH_SECRET=replace-with-a-long-random-string

# LinkedIn OpenID Connect — https://www.linkedin.com/developers/apps
# Redirect URL: {NEXT_PUBLIC_APP_URL}/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Google sign-in — https://console.cloud.google.com/apis/credentials
# Redirect: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In — https://developer.apple.com/account/resources/identifiers
# Redirect: {NEXT_PUBLIC_APP_URL}/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Welcome email on sign-up — https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "Interlink <hello@yourdomain.com>"
EMAIL_FROM=

# Optional — booking confirmation SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional — lock down POST /api/notify/sms
NOTIFY_SECRET=

# Optional — real Stripe Checkout for Premier + booking fees
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — live restaurant search (Google Places Nearby)
GOOGLE_PLACES_API_KEY=

# Local demo only — leave both blank on the live site.
# 1 = show "Enter demo" and the /demo bypass
NEXT_PUBLIC_ENABLE_DEMO=
# 1 = put the 18 sample members in Discover (they accept intros and reply)
NEXT_PUBLIC_ENABLE_DEMO_PROFILES=

# Server-only walkthrough owner. Leave all three unset in production.
# Do not commit mailbox or password values.
# ENABLE_WALKTHROUGH_OWNER=1
# WALKTHROUGH_OWNER_EMAIL=
# WALKTHROUGH_OWNER_PASSWORD=

# Operator BLACK grant secret (no invite codes — BLACK is bought or earned)
ADMIN_SECRET=

# Waitlist → existing Interlink Waitlist Notion database
# Database: https://app.notion.com/p/a6ffe8d865f94b25a851e2331a31c65b
# 1. https://www.notion.so/my-integrations → New integration (Internal)
# 2. Open the database → ••• → Connections → connect that integration
# 3. Paste the integration secret here (Vercel → Settings → Environment Variables)
NOTION_API_KEY=
# NOTION_TOKEN=
NOTION_WAITLIST_DATABASE_ID=a6ffe8d865f94b25a851e2331a31c65b
# Optional — only needed if the 2022 database_id path fails
# NOTION_WAITLIST_DATA_SOURCE_ID=696ae013-5f44-4858-a4e8-106240a36d5a
# Public form fallback (same database) if the API key is missing
# NEXT_PUBLIC_NOTION_WAITLIST_FORM_URL=https://tiny-palladium-a02.notion.site/cc1d0f6fc49348239d2e24fdfa7a41c1?pvs=105

# Optional Plausible analytics domain (e.g. interlink.app)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
