generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id             String   @id @default(cuid())
  linkedInId     String?  @unique
  googleId       String?  @unique
  appleId        String?  @unique
  email          String?  @unique
  passwordHash   String?
  name           String
  jobTitle       String   @default("")
  bio            String   @default("")
  photo          String   @default("")
  cityName       String   @default("New York")
  cityCountry    String   @default("USA")
  cityLat        Float    @default(40.7128)
  cityLng        Float    @default(-74.006)
  travel         String   @default("worldwide")
  meetPreference String   @default("open")
  lookingForJson String   @default("[]")
  ideaTagsJson   String   @default("[]")
  verificationsJson String @default("[]")
  workJson       String   @default("[]")
  /// Employer or venture. Public. Empty until the member sets it.
  company        String   @default("")
  /// Canonical industry label (see lib/interests.ts). Empty until set.
  industry       String   @default("")
  /// True for seeded, guest, and bot profiles. Real signups stay false.
  isSample       Boolean  @default(false)
  /// seed | guest | bot | sample | empty for a real member
  sampleKind     String   @default("")
  phone          String?
  black          Boolean  @default(false)
  blackSince     DateTime?
  /// paid | earned | granted
  blackSource    String?
  premierActive  Boolean  @default(false)
  premierInterval String?
  premierStartedAt String?
  premierTrialEndsAt String?
  /// Set only when a confirmation link matches this member and account email.
  emailVerifiedAt String?
  meetingsAttended Int    @default(0)
  /// Set only when the member checks the consent box. Null means not accepted.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  /// Set when the account is anonymized. The row stays for payment and safety records.
  deletedAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connectionsFrom Connection[] @relation("from")
  connectionsTo   Connection[] @relation("to")
  chatMembers     ChatMember[]
  messages        Message[]
  blocksFrom      Block[]      @relation("blocker")
  blocksTo        Block[]      @relation("blocked")
  blackInvitesSent     BlackInvite[]     @relation("blackInviteFrom")
  blackInvitesReceived BlackInvite[]     @relation("blackInviteTo")
  blackConnectionsHeld BlackConnection[] @relation("blackHolder")
  blackConnectionsWith BlackConnection[] @relation("blackPeer")
  interests            MemberInterest[]
  eventInterests       EventInterest[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([isSample])
  @@index([deletedAt])
}

/// One row per canonical interest a member selected.
/// Slugs come from lib/interests.ts — not free text.
/// Custom tags stay on Member.ideaTagsJson and are not rows here.
model MemberInterest {
  memberId String
  slug     String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, slug])
  @@index([slug])
}

/// One RSVP per member per catalog event.
/// Matches the live EventInterest table (see 20260913040000_event_interest):
/// id, memberId, eventId, status, createdAt, updatedAt.
/// status is interested | going | passed. Older rows may use saved for interested.
model EventInterest {
  id        String   @id @default(cuid())
  memberId  String
  eventId   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@index([memberId])
}

/// An invitation into the BLACK network, always raised inside a private DM.
/// Only a pairing that includes a BLACK member is valid, and accepting one
/// awards BLACK CONNECTION to the other side — never BLACK itself.
model BlackInvite {
  id          String    @id @default(cuid())
  fromId      String
  toId        String
  chatId      String?
  /// connection | meeting
  kind        String    @default("connection")
  /// pending | accepted | declined
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  from        Member    @relation("blackInviteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          Member    @relation("blackInviteTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([toId, status])
}

/// A settled BLACK network connection. `blackMemberId` is the BLACK party;
/// `peerId` is the member who earns the BLACK CONNECTION credential.
/// The unique pair means one connection can never be counted twice.
model BlackConnection {
  id            String   @id @default(cuid())
  blackMemberId String
  peerId        String
  /// invite | meeting
  source        String   @default("invite")
  createdAt     DateTime @default(now())
  blackMember   Member   @relation("blackHolder", fields: [blackMemberId], references: [id], onDelete: Cascade)
  peer          Member   @relation("blackPeer", fields: [peerId], references: [id], onDelete: Cascade)

  @@unique([blackMemberId, peerId])
  @@index([peerId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  /// Restrict: anonymized accounts keep the row, and deleting a member must not erase a block.
  blocker   Member   @relation("blocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blocked   Member   @relation("blocked", fields: [blockedId], references: [id], onDelete: Restrict)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String   @default("")
  memberId  String?
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

/// Fixed-window counters shared across Vercel serverless isolates.
/// Keys are route + IP, or route + a hash of the account — never a raw email.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Connection {
  id         String   @id @default(cuid())
  fromId     String
  toId       String
  status     String   @default("requested")
  meetupJson String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  from       Member   @relation("from", fields: [fromId], references: [id])
  to         Member   @relation("to", fields: [toId], references: [id])

  @@unique([fromId, toId])
  @@index([toId])
}

model Chat {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   ChatMember[]
  messages  Message[]
}

model ChatMember {
  id       String @id @default(cuid())
  chatId   String
  memberId String
  chat     Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([chatId, memberId])
}

model Message {
  id         String   @id @default(cuid())
  chatId     String
  senderId   String
  text       String   @default("")
  system     Boolean  @default(false)
  createdAt  DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     Member   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

/// Safety report. Production already stores alsoBlocked, category, notes,
/// and status — keep them on the model so schema sync never DROP them.
/// reporterId and peerId are not foreign keys, so a member delete cannot cascade these rows away.
model Report {
  id          String   @id @default(cuid())
  reporterId  String
  peerId      String
  /// harassment | spam | fraud | impersonation | inappropriate | suspicious_account | fake_profile | scam | other
  category    String   @default("other")
  reason      String
  /// open | reviewing | resolved | dismissed
  status      String   @default("open")
  notes       String   @default("")
  alsoBlocked Boolean  @default(false)
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  @@index([status, createdAt])
  @@index([peerId, createdAt])
  @@index([reporterId, createdAt])
}

/// Single-use account-email confirmation. Only the hash is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  memberId  String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([memberId])
}
